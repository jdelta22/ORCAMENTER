# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_USER=orcamenter
POSTGRES_PASSWORD=orcamenter
POSTGRES_DB=orcamenter
POSTGRES_PORT=5432

# Usado pelo Django dentro do Docker (host = serviço "db")
DATABASE_URL=postgres://orcamenter:orcamenter@db:5432/orcamenter

# Portas expostas no host
BACKEND_PORT=8000
FRONTEND_PORT=5173

# URL da API vista pelo navegador (não use o nome do container)
VITE_API_URL=http://localhost:8000/api
